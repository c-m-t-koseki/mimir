{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir Settings",
  "version": "0.1.0",
  "identifier": "dev.tkoseki.mimir.settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mimir 設定",
        "width": 720,
        "height": 600,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
