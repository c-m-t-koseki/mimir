<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>MimirIME</string>
    <key>CFBundleDisplayName</key>
    <string>Mimir</string>
    <key>CFBundleName</key>
    <string>Mimir</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleIdentifier</key>
    <string>dev.tkoseki.inputmethod.Mimir</string>
    <key>CFBundleIconFile</key>
    <string>mimir.icns</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSBackgroundOnly</key>
    <true/>
    <key>LSUIElement</key>
    <true/>

    <key>InputMethodConnectionName</key>
    <string>dev.tkoseki.inputmethod.Mimir_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>MimirInputController</string>

    <key>TISIntendedLanguage</key>
    <string>ja</string>
    <!-- Black-glyph template icons: the system re-tints them for the
         light/dark menu bar and selection highlight. -->
    <key>TISIconIsTemplate</key>
    <true/>

    <key>ComponentInputModeDict</key>
    <dict>
      <key>tsInputModeListKey</key>
      <dict>

        <key>dev.tkoseki.inputmethod.Mimir.Japanese</key>
        <dict>
          <key>TISInputSourceID</key>
          <string>dev.tkoseki.inputmethod.Mimir.Japanese</string>
          <key>TISIntendedLanguage</key>
          <string>ja</string>
          <key>tsInputModeScriptKey</key>
          <string>smJapanese</string>
          <key>tsInputModeDefaultStateKey</key>
          <true/>
          <key>tsInputModeIsVisibleKey</key>
          <true/>
          <key>tsInputModePrimaryInScriptKey</key>
          <true/>
          <key>tsInputModeJISKeyboardShortcutKey</key>
          <integer>1</integer>
          <key>tsInputModeMenuIconFileKey</key>
          <string>mimir.tiff</string>
          <key>tsInputModePaletteIconFileKey</key>
          <string>mimir.tiff</string>
        </dict>

        <!-- Mimir's own direct-ASCII mode (英数 / `l`). Registered so the
             menu bar icon can show it: the frontend selects this mode when
             the engine goes ASCII and the Japanese one when it comes back.
             JISKeyboardShortcutKey 2 makes the JIS 英数 key select this mode
             (1 = かな selects Japanese) instead of the OS English source, and
             the intended language ja lists it under 日本語. -->
        <key>dev.tkoseki.inputmethod.Mimir.Roman</key>
        <dict>
          <key>TISInputSourceID</key>
          <string>dev.tkoseki.inputmethod.Mimir.Roman</string>
          <key>TISIntendedLanguage</key>
          <string>ja</string>
          <key>tsInputModeScriptKey</key>
          <string>smRoman</string>
          <key>tsInputModeDefaultStateKey</key>
          <true/>
          <key>tsInputModeIsVisibleKey</key>
          <true/>
          <key>tsInputModePrimaryInScriptKey</key>
          <true/>
          <key>tsInputModeJISKeyboardShortcutKey</key>
          <integer>2</integer>
          <key>tsInputModeMenuIconFileKey</key>
          <string>mimir-roman.tiff</string>
          <key>tsInputModePaletteIconFileKey</key>
          <string>mimir-roman.tiff</string>
        </dict>

      </dict>

      <key>tsVisibleInputModeOrderedArrayKey</key>
      <array>
        <string>dev.tkoseki.inputmethod.Mimir.Japanese</string>
        <string>dev.tkoseki.inputmethod.Mimir.Roman</string>
      </array>
    </dict>

    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
      <string>Latn</string>
      <string>Hira</string>
      <string>Kana</string>
    </array>
    <key>tsInputMethodIconFileKey</key>
    <string>mimir.tiff</string>

  </dict>
</plist>
